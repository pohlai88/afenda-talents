# Neon POOLED endpoint (host contains "-pooler") — used by the running app.
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
# Neon DIRECT endpoint — used by prisma migrate / db seed only (DECISIONS.md D1).
DIRECT_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

APP_URL="http://localhost:3000"
# 32+ bytes of random. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""
ADMIN_EMAIL="hr@example.com"
# 24+ characters, generated not chosen. lib/env.ts refuses anything shorter at boot.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=""
# Leave empty in development: emails print to stdout instead of sending.
RESEND_API_KEY=""
MAIL_FROM="Afenda Talents <noreply@example.com>"
INVITE_TTL_DAYS="14"
# Interpolated into the candidate consent text. Changing it changes the promise.
RETENTION_DAYS="180"

# Shadcn Studio Pro — development/design-time credentials only.
# Put the real values in a local .env file. Never commit them.
# Official Shadcn Studio CLI v4 variable names:
EMAIL=""
LICENSE_KEY=""
