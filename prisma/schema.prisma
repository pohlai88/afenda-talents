// Afenda Talents data model — post-contract (D18).
// See docs/superpowers/specs/2026-08-05-configurable-assessments-design.md
//
// Prisma 7: connection URLs live in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               String   @default("VIEWER")
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  publishedVersions AssessmentVersion[] @relation("PublishedBy")
}

/// Person identity only. Invite lifecycle lives on CandidateAssignment (D18).
model Candidate {
  id          String                @id @default(cuid())
  email       String                @unique
  fullName    String
  createdAt   DateTime              @default(now())
  assignments CandidateAssignment[]
}

model Assessment {
  id            String              @id @default(cuid())
  key           String?             @unique
  title         String
  kind          String              @default("ORGANISATION")
  isSystem      Boolean             @default(false)
  status        String              @default("DRAFT")
  draftDocument Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  versions      AssessmentVersion[]
}

model AssessmentVersion {
  id            String                @id @default(cuid())
  assessmentId  String
  versionNumber Int
  document      Json
  publishedAt   DateTime              @default(now())
  publishedById String?
  assessment    Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  publishedBy   User?                 @relation("PublishedBy", fields: [publishedById], references: [id])
  rounds        HiringRound[]
  assignments   CandidateAssignment[]
  results       Result[]

  @@unique([assessmentId, versionNumber])
}

model HiringRound {
  id                  String                @id @default(cuid())
  name                String
  status              String                @default("DRAFT")
  assessmentVersionId String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assessmentVersion   AssessmentVersion     @relation(fields: [assessmentVersionId], references: [id])
  assignments         CandidateAssignment[]
}

model CandidateAssignment {
  id                  String            @id @default(cuid())
  candidateId         String
  hiringRoundId       String
  assessmentVersionId String
  status              String            @default("DRAFT")
  invitedById         String?
  tokenHash           String?           @unique
  expiresAt           DateTime?
  sentAt              DateTime?
  openedAt            DateTime?
  consentedAt         DateTime?
  startedAt           DateTime?
  submittedAt         DateTime?
  createdAt           DateTime          @default(now())
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  hiringRound         HiringRound       @relation(fields: [hiringRoundId], references: [id])
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  responses           Response[]
  result              Result?

  @@unique([candidateId, hiringRoundId])
}

model Response {
  id           String              @id @default(cuid())
  assignmentId String
  questionId   String
  /// Likert 1–5; null for text items.
  value        Int?
  textValue    String?
  msOnItem     Int                 @default(0)
  updatedAt    DateTime            @updatedAt
  assignment   CandidateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
}

model Result {
  id                  String              @id @default(cuid())
  assignmentId        String              @unique
  assessmentVersionId String
  dimensionScores     Json
  /// responseContext outcomes (legacy column name).
  validityFlags       Json
  totalSeconds        Int
  serverWindowSeconds Int
  computedAt          DateTime            @default(now())
  assignment          CandidateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assessmentVersion   AssessmentVersion   @relation(fields: [assessmentVersionId], references: [id])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  subjectId String?
  meta      Json?
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
