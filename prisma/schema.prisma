// Afenda data model — Talents + Corporate Administration.
// Talents contract: D18. Corporate Administration boundary: D19.
//
// Prisma 7: connection URLs live in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VIEWER
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentKind {
  ORGANISATION
  TEMPLATE
  SYSTEM
}

enum RoundStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum AssignmentStatus {
  DRAFT
  SENT
  STARTED
  SUBMITTED
  SCORED
  EXPIRED
  REVOKED
}

enum AdministrativeObligationStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum AdministrativeDueItemStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AdministrativeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdministrativePaymentStatus {
  NOT_PAID
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum AdministrativeRecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum AdministrativeCustomFieldScope {
  COUNTERPARTY
  SITE
  OBLIGATION
  DUE_ITEM
  PAYMENT
}

enum AdministrativeCustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  URL
  EMAIL
  PHONE
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               UserRole @default(VIEWER)
  mustChangePassword Boolean  @default(false)
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now())

  publishedVersions AssessmentVersion[] @relation("PublishedBy")

  ownedAdministrativeObligations    AdministrativeObligation[]          @relation("AdministrativeObligationOwner")
  requestedAdministrativePayments  AdministrativePayment[]             @relation("AdministrativePaymentRequester")
  approvedAdministrativePayments   AdministrativePayment[]             @relation("AdministrativePaymentApprover")
  reconciledAdministrativePayments AdministrativePayment[]             @relation("AdministrativePaymentReconciler")
  createdAdministrativeCustomFields AdministrativeCustomFieldDefinition[] @relation("AdministrativeCustomFieldCreator")
}

model Candidate {
  id          String                @id @default(cuid())
  email       String                @unique
  fullName    String
  createdAt   DateTime              @default(now())
  assignments CandidateAssignment[]
}

model Assessment {
  id            String           @id @default(cuid())
  key           String?          @unique
  title         String
  kind          AssessmentKind   @default(ORGANISATION)
  isSystem      Boolean          @default(false)
  status        AssessmentStatus @default(DRAFT)
  draftDocument Json?
  draftRevision Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  versions      AssessmentVersion[]
}

model AssessmentVersion {
  id            String                @id @default(cuid())
  assessmentId  String
  versionNumber Int
  document      Json
  publishedAt   DateTime              @default(now())
  publishedById String?
  assessment    Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  publishedBy   User?                 @relation("PublishedBy", fields: [publishedById], references: [id])
  rounds        HiringRound[]
  assignments   CandidateAssignment[]
  results       Result[]

  @@unique([assessmentId, versionNumber])
}

model HiringRound {
  id                  String                @id @default(cuid())
  name                String
  status              RoundStatus           @default(DRAFT)
  assessmentVersionId String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assessmentVersion   AssessmentVersion     @relation(fields: [assessmentVersionId], references: [id])
  assignments         CandidateAssignment[]
}

model CandidateAssignment {
  id                  String           @id @default(cuid())
  candidateId         String
  hiringRoundId       String
  assessmentVersionId String
  status              AssignmentStatus @default(DRAFT)
  invitedById         String?
  tokenHash           String?          @unique
  expiresAt           DateTime?
  sentAt              DateTime?
  openedAt            DateTime?
  consentedAt         DateTime?
  startedAt           DateTime?
  submittedAt         DateTime?
  createdAt           DateTime          @default(now())
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  hiringRound         HiringRound       @relation(fields: [hiringRoundId], references: [id])
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  responses           Response[]
  result              Result?

  @@unique([candidateId, hiringRoundId])
  @@index([hiringRoundId, status])
  @@index([hiringRoundId, sentAt])
  @@index([hiringRoundId, submittedAt])
  @@index([invitedById, hiringRoundId])
}

model Response {
  id           String              @id @default(cuid())
  assignmentId String
  questionId   String
  value        Int?
  textValue    String?
  msOnItem     Int                 @default(0)
  updatedAt    DateTime            @updatedAt
  assignment   CandidateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
  @@index([assignmentId, updatedAt])
}

model Result {
  id                  String              @id @default(cuid())
  assignmentId        String              @unique
  assessmentVersionId String
  dimensionScores     Json
  validityFlags       Json
  totalSeconds        Int
  serverWindowSeconds Int
  computedAt          DateTime            @default(now())
  assignment          CandidateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assessmentVersion   AssessmentVersion   @relation(fields: [assessmentVersionId], references: [id])
}

model AdministrativeCounterparty {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  type             String
  registrationNo   String?
  taxId            String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  countryCode      String?
  websiteUrl       String?
  defaultCurrency  String?
  paymentTermsDays Int?
  isActive         Boolean  @default(true)
  notes            String?
  customFields     Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  obligations     AdministrativeObligation[]
  contacts        AdministrativeCounterpartyContact[]
  serviceCoverage AdministrativeServiceCoverage[]
  obligationRoles AdministrativeObligationParty[]

  @@index([name])
  @@index([type, isActive])
}

model AdministrativeSite {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String
  organization String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  stateRegion  String?
  postalCode   String?
  countryCode  String?
  timezone     String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isActive     Boolean  @default(true)
  notes        String?
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceCoverage AdministrativeServiceCoverage[]
  obligations     AdministrativeObligationSite[]

  @@index([name])
  @@index([organization, isActive])
  @@index([type, isActive])
  @@index([countryCode, stateRegion])
}

model AdministrativeCounterpartyContact {
  id             String   @id @default(cuid())
  counterpartyId String
  name           String
  jobTitle       String?
  department     String?
  email          String?
  phone          String?
  mobile         String?
  role           String?
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  counterparty AdministrativeCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId, isActive])
  @@index([counterpartyId, role])
  @@index([email])
}

model AdministrativeServiceCoverage {
  id               String   @id @default(cuid())
  siteId           String
  counterpartyId   String
  serviceCategory  String
  roleCode         String?
  effectiveFrom    DateTime? @db.Date
  effectiveTo      DateTime? @db.Date
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  serviceLevel     String?
  emergencyContact String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site         AdministrativeSite         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  counterparty AdministrativeCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@index([siteId, isActive])
  @@index([counterpartyId, isActive])
  @@index([siteId, serviceCategory, isActive])
  @@index([counterpartyId, serviceCategory, isActive])
}

model AdministrativeObligation {
  id                 String                          @id @default(cuid())
  code               String                          @unique
  organization       String
  category           String
  title              String
  counterpartyId     String
  assetReference     String?
  ownerId            String?
  status             AdministrativeObligationStatus @default(DRAFT)
  startDate          DateTime                        @db.Date
  endDate            DateTime?                       @db.Date
  recurring          Boolean                         @default(false)
  recurrenceInterval Int?
  recurrenceUnit     AdministrativeRecurrenceUnit?
  expectedAmount     Decimal?                        @db.Decimal(18, 2)
  currency           String
  firstDueDate       DateTime?                       @db.Date
  nextDueDate        DateTime?                       @db.Date
  autoRenew          Boolean                         @default(false)
  renewalDate        DateTime?                       @db.Date
  noticeDays         Int?
  contractRequired   Boolean                         @default(false)
  contractReference  String?
  contractFileUrl    String?
  paymentMethod      String?
  notes              String?
  customFields       Json                            @default("{}")
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  counterparty AdministrativeCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  owner        User?                      @relation("AdministrativeObligationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueItems     ObligationDueItem[]
  sites        AdministrativeObligationSite[]
  parties      AdministrativeObligationParty[]
  lines        AdministrativeObligationLine[]

  @@index([organization, status])
  @@index([category, status])
  @@index([counterpartyId, status])
  @@index([ownerId, status])
  @@index([nextDueDate, status])
  @@index([endDate, status])
  @@index([renewalDate, status])
}

model AdministrativeObligationSite {
  obligationId String
  siteId       String
  scopeRole    String?
  notes        String?
  createdAt    DateTime @default(now())

  obligation AdministrativeObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  site       AdministrativeSite       @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@id([obligationId, siteId])
  @@index([siteId])
}

model AdministrativeObligationParty {
  obligationId  String
  counterpartyId String
  roleCode      String
  isPrimary     Boolean   @default(false)
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?
  createdAt     DateTime  @default(now())

  obligation  AdministrativeObligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  counterparty AdministrativeCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@id([obligationId, counterpartyId, roleCode])
  @@index([counterpartyId])
  @@index([obligationId, isPrimary])
}

/// Payable/scheduled component beneath an agreement. Business line types remain configurable data;
/// lifecycle is represented by isActive. Legacy obligation amount/recurrence fields remain as the
/// compatibility/default-line source while CA-03 is adopted incrementally.
model AdministrativeObligationLine {
  id                 String                         @id @default(cuid())
  obligationId       String
  code               String
  name               String
  lineType           String
  expectedAmount     Decimal?                       @db.Decimal(18, 2)
  currency           String
  recurring          Boolean                        @default(false)
  recurrenceInterval Int?
  recurrenceUnit     AdministrativeRecurrenceUnit?
  firstDueDate       DateTime?                      @db.Date
  nextDueDate        DateTime?                      @db.Date
  invoiceRequired    Boolean                        @default(false)
  paymentTermsDays   Int?
  startDate          DateTime?                      @db.Date
  endDate            DateTime?                      @db.Date
  isActive           Boolean                        @default(true)
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  obligation AdministrativeObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  dueItems    ObligationDueItem[]

  @@unique([obligationId, code])
  @@index([obligationId, isActive])
  @@index([nextDueDate, isActive])
  @@index([lineType, isActive])
}

model ObligationDueItem {
  id              String                      @id @default(cuid())
  obligationId    String
  lineId          String
  periodLabel     String
  dueDate         DateTime                    @db.Date
  expectedAmount  Decimal?                    @db.Decimal(18, 2)
  invoiceAmount   Decimal?                    @db.Decimal(18, 2)
  currency        String
  invoiceRequired Boolean                     @default(false)
  invoiceNumber   String?
  invoiceFileUrl  String?
  status          AdministrativeDueItemStatus @default(OPEN)
  disputeFlag     Boolean                     @default(false)
  completedDate   DateTime?                   @db.Date
  notes           String?
  customFields    Json                        @default("{}")
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  obligation AdministrativeObligation     @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  line       AdministrativeObligationLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  payments   AdministrativePayment[]

  @@unique([lineId, dueDate, periodLabel])
  @@index([obligationId, dueDate])
  @@index([dueDate, status])
  @@index([obligationId, status])
  @@index([lineId, status])
  @@index([disputeFlag, status])
}

model AdministrativePayment {
  id                 String                       @id @default(cuid())
  dueItemId          String
  requestDate        DateTime                     @default(now())
  requestedById      String?
  requestedAmount    Decimal                      @db.Decimal(18, 2)
  approvalStatus     AdministrativeApprovalStatus @default(PENDING)
  approvedById       String?
  approvalDate       DateTime?
  approvedAmount     Decimal?                     @db.Decimal(18, 2)
  paymentStatus      AdministrativePaymentStatus  @default(NOT_PAID)
  paymentDate        DateTime?
  paidAmount         Decimal?                     @db.Decimal(18, 2)
  paymentMethod      String?
  paymentReference   String?
  paymentProofUrl    String?
  reconciledAt       DateTime?
  reconciledById     String?
  notes              String?
  customFields       Json                         @default("{}")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  dueItem      ObligationDueItem @relation(fields: [dueItemId], references: [id], onDelete: Restrict)
  requestedBy  User?             @relation("AdministrativePaymentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy   User?             @relation("AdministrativePaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reconciledBy User?             @relation("AdministrativePaymentReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([dueItemId, approvalStatus])
  @@index([dueItemId, paymentStatus])
  @@index([requestDate])
  @@index([reconciledAt])
}

model AdministrativeCustomFieldDefinition {
  id          String                         @id @default(cuid())
  scope       AdministrativeCustomFieldScope
  key         String
  label       String
  dataType    AdministrativeCustomFieldType
  description String?
  placeholder String?
  required    Boolean                        @default(false)
  options     Json?
  showInList  Boolean                        @default(false)
  isActive    Boolean                        @default(true)
  sortOrder   Int                            @default(0)
  createdById String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  createdBy User? @relation("AdministrativeCustomFieldCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([scope, isActive, sortOrder])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  subjectId String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
