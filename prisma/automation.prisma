enum AdministrativeAutomationJobType {
  DAILY
  WEEKLY
}

enum AdministrativeAutomationRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
}

model AdministrativeAutomationRun {
  id                String                            @id
  runKey            String                            @unique
  jobType           AdministrativeAutomationJobType
  status            AdministrativeAutomationRunStatus @default(RUNNING)
  scheduledFor      DateTime
  workItemsCreated  Int                               @default(0)
  escalationsChanged Int                              @default(0)
  remindersCreated  Int                               @default(0)
  digestRecipients  Int                               @default(0)
  digestSent        Int                               @default(0)
  digestFailed      Int                               @default(0)
  providerEvidence  Json?
  failureCode       String?
  startedAt         DateTime                          @default(now())
  completedAt       DateTime?
  createdAt         DateTime                          @default(now())

  @@index([jobType, scheduledFor])
  @@index([status, scheduledFor])
}